<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ConectaInventory</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ConectaInventory.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">ConectaInventory</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                            aria-controls="menu" aria-expanded="false" aria-label="Menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="menu">
                        <ul class="navbar-nav me-auto">
                            @* Menu segun rol (documento 9.4.2) *@
                            @if (User.IsInRole(RolNombre.Bodeguero))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Inventario" asp-action="Recepcion">Recepcion</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Identificacion" asp-action="Escanear">Escaneo QR</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Inventario" asp-action="Reubicar">Reubicacion</a></li>
                            }
                            @if (User.IsInRole(RolNombre.Administrador))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Inventario" asp-action="Alta">Alta de equipo</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Identificacion" asp-action="Index">Etiquetas QR</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="DiagnosticoBaja" asp-action="Solicitudes">Bajas</a></li>
                            }
                            @if (User.IsInRole(RolNombre.SoporteTecnico))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="DiagnosticoBaja" asp-action="Diagnostico">Diagnostico</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="DiagnosticoBaja" asp-action="SolicitarBaja">Solicitar baja</a></li>
                            }
                            @if (!User.IsInRole(RolNombre.Beneficiario)) { <li class="nav-item"><a class="nav-link" asp-controller="Inventario" asp-action="Stock">Stock</a></li> }
                            @if (User.IsInRole(RolNombre.Beneficiario) || User.IsInRole(RolNombre.Administrador) || User.IsInRole(RolNombre.Bodeguero)) { <li class="nav-item"><a class="nav-link" asp-controller="Prestamos" asp-action="Index">Préstamos</a></li> }
                        </ul>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center">
                            <span class="navbar-text me-3">@User.Identity.Name (@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value))</span>
                            <button type="submit" class="btn btn-outline-light btn-sm">Salir</button>
                        </form>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3 pt-3">
            @if (TempData["Ok"] is string ok)
            {
                <div class="alert alert-success" role="alert">@ok</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger" role="alert">@error</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">ConectaInventory - Analisis de Sistemas, Grupo 301 - Sprint 02 (Módulos 01 y 02)</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
