@model SolicitudPrestamo
@{ ViewData["Title"]=Model.Radicado; var disp=(Dictionary<int,int>)ViewBag.Disponibilidad; var eventos=(List<EventoPrestamo>)ViewBag.Eventos; var p=Model.Prestamo; bool benef=User.IsInRole(RolNombre.Beneficiario), admin=User.IsInRole(RolNombre.Administrador), bodega=User.IsInRole(RolNombre.Bodeguero); bool pendiente=Model.Estado is EstadoSolicitudPrestamo.Pendiente or EstadoSolicitudPrestamo.PendienteAjuste or EstadoSolicitudPrestamo.EnRevision; }
<h1 class="h3">@Model.Radicado · @Model.Estado</h1><a asp-action="Index">Volver a solicitudes e historial</a>
<dl class="row mt-3"><dt class="col-sm-3">Titular</dt><dd class="col-sm-9">@Model.Beneficiario.Usuario.NombreCompleto</dd><dt class="col-sm-3">Institución</dt><dd class="col-sm-9">@(Model.InstitucionRepresentada??"Individual")</dd><dt class="col-sm-3">Periodo</dt><dd class="col-sm-9">@Model.FechaInicioPrevista / @Model.FechaFinPrevista</dd><dt class="col-sm-3">Propósito</dt><dd class="col-sm-9">@Model.Proposito</dd><dt class="col-sm-3">Radicación</dt><dd class="col-sm-9">@Model.FechaSolicitud</dd><dt class="col-sm-3">Decisión</dt><dd class="col-sm-9">@Model.UsuarioDecision?.NombreCompleto @Model.FechaDecision @Model.MotivoDecision</dd></dl>
<table class="table"><thead><tr><th>Categoría</th><th>Solicitada</th><th>Propuesta</th><th>Aprobada</th><th>Reservada</th><th>Disponible (orientativo)</th></tr></thead><tbody>@foreach(var d in Model.Detalles){<tr><td>@d.Categoria.Nombre</td><td>@d.CantidadSolicitada</td><td>@d.CantidadPropuesta</td><td>@d.CantidadAprobada</td><td>@d.CantidadReservada</td><td>@disp.GetValueOrDefault(d.CategoriaEquipoId)</td></tr>}</tbody></table>
@if(benef&&pendiente){<a class="btn btn-primary mb-2" asp-action="Editar" asp-route-id="@Model.Id">Modificar / aceptar ajuste</a>}
@if((benef||admin)&&(pendiente||Model.Estado==EstadoSolicitudPrestamo.Aprobada)){<form asp-action="Cancelar" method="post" class="mb-3"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-outline-danger" onclick="return confirm('¿Cancelar solicitud y liberar reservas?')">Cancelar solicitud</button></form>}
@if(admin&&(Model.Estado is EstadoSolicitudPrestamo.Pendiente or EstadoSolicitudPrestamo.EnRevision)){
<section class="card p-3 mb-3"><h2 class="h5">Evaluación administrativa</h2><form asp-action="Evaluar" method="post"><input type="hidden" name="id" value="@Model.Id"/><label>Motivo (obligatorio al rechazar)</label><textarea maxlength="500" name="motivo" class="form-control mb-2"></textarea><button name="decision" value="aprobar" class="btn btn-success">Aprobar y reservar</button> <button name="decision" value="ajustar" class="btn btn-warning">Proponer ajuste según disponibilidad</button> <button name="decision" value="rechazar" class="btn btn-danger">Rechazar</button></form></section>}
@if(bodega&&Model.Estado==EstadoSolicitudPrestamo.Aprobada){var equipos=(List<Equipo>)ViewBag.Equipos;
<section class="card p-3 mb-3"><h2 class="h5">Registrar entrega completa</h2><p><a asp-action="ActaBorrador" asp-route-id="@Model.Id" target="_blank" rel="noopener">Abrir acta imprimible para completar y firmar</a></p><form asp-action="Entregar" method="post" enctype="multipart/form-data"><input type="hidden" name="id" value="@Model.Id"/><label>Receptor verificado</label><select name="receptor" required class="form-select mb-2"><option value="">Seleccione titular verificado</option><option value="@Model.BeneficiarioId">@Model.Beneficiario.Usuario.NombreCompleto</option></select><label>Referencia de identidad comprobada (evite datos sensibles innecesarios)</label><input name="identidad" required maxlength="100" class="form-control mb-2"/><label>Referencia estable del acta firmada (folio o identificador del documento custodiado)</label><input name="referencia" required maxlength="500" class="form-control mb-2"/><label>Acta firmada en PDF (máximo 5 MB)</label><input type="file" name="documento" accept="application/pdf,.pdf" required class="form-control mb-2"/><div class="form-check"><input class="form-check-input" type="checkbox" name="firma" value="true" required id="firma"/><label for="firma">Acta firmada y aceptación comprobada</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="inspeccion" value="true" required id="inspeccion"/><label for="inspeccion">Equipos inspeccionados e identificados</label></div><h3 class="h6 mt-3">Equipos físicos disponibles</h3>@foreach(var e in equipos){<div class="form-check"><input type="checkbox" class="form-check-input" name="equipos" value="@e.Id" id="e@e.Id"/><label for="e@e.Id">@e.Categoria.Nombre · @e.Identificador · @e.Serial · QR @e.CodigoQR?.Valor</label></div>}<button class="btn btn-primary mt-3">Confirmar entrega</button></form></section>}
@if(p!=null){<section class="card p-3 mb-3"><h2 class="h5">Préstamo PRE-@p.Id.ToString("D6") · @p.EstadoActual</h2><p>Tipo: @p.TipoPrestamo | Entrega: @p.FechaEntrega | Vencimiento: @p.FechaDevolucionPrevista | Devolución programada: @p.FechaProgramadaDevolucion</p>
@if(p.Entrega!=null){<p>Responsable de entrega: @p.Entrega.Responsable.NombreCompleto | Acta: @p.Entrega.Acta?.ReferenciaDocumento | Firma: @p.Entrega.Acta?.FechaFirma (@p.Entrega.Acta?.EstadoFirma) | <a asp-action="DescargarActa" asp-route-id="@Model.Id">Descargar acta custodiada</a></p>}
<ul>@foreach(var d in p.Detalles){<li>@d.Equipo.Identificador · @d.Equipo.Serial · @d.Equipo.Marca @d.Equipo.Modelo</li>}</ul>
@if(!string.IsNullOrWhiteSpace(p.ObservacionesFaltantes)){<div class="alert alert-warning" style="white-space:pre-wrap">@p.ObservacionesFaltantes</div>}
@if(bodega&&(p.EstadoActual is EstadoPrestamo.Activo or EstadoPrestamo.Vencido)){
<form asp-action="Programar" method="post" class="mb-3"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="prestamoId" value="@p.Id"/><label>Programar devolución</label><input type="date" name="fecha" required class="form-control mb-2"/><button class="btn btn-outline-primary">Guardar fecha</button></form>
<h3 class="h6">Registrar recepción e inspección</h3><form asp-action="Devolver" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="prestamoId" value="@p.Id"/><table class="table"><thead><tr><th>Equipo</th><th>Condición</th><th>Novedades</th></tr></thead><tbody>@foreach(var d in p.Detalles){<tr><td>@d.Equipo.Identificador · @d.Equipo.Serial</td><td><select name="condiciones[@d.EquipoId]" required class="form-select"><option value="">Seleccione</option><option value="Apto">Recibido, inspección favorable</option><option value="Danado">Recibido, dañado</option><option value="Faltante">Faltante</option></select></td><td><input name="novedades[@d.EquipoId]" maxlength="500" class="form-control"/></td></tr>}</tbody></table><label>Observación general (obligatoria si faltan equipos)</label><textarea name="observacion" maxlength="2000" class="form-control mb-2"></textarea><button class="btn btn-primary">Registrar recepción</button></form>}
@if(p.Devolucion!=null){<h3 class="h6">Devolución cerrada</h3><p>@p.Devolucion.FechaRealRecepcion · @p.Devolucion.Responsable.NombreCompleto · Tardía: @(p.Devolucion.Tardia?"Sí":"No")</p><table class="table"><thead><tr><th>Equipo</th><th>Condición</th><th>Novedades</th><th>Destino</th></tr></thead><tbody>@foreach(var d in p.Devolucion.Detalles){<tr><td>@d.Equipo.Serial</td><td>@d.Condicion</td><td>@d.Novedades</td><td>@d.DestinoEquipo</td></tr>}</tbody></table>}
</section>}
<h2 class="h5">Eventos y avisos</h2><ul class="list-group mb-3">@foreach(var e in eventos){<li class="list-group-item">@e.Fecha · @e.Usuario.NombreCompleto · @e.Mensaje</li>}</ul>
