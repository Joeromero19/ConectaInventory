@model List<SolicitudPrestamo>
@{ ViewData["Title"]="Solicitudes e historial"; var categorias=(List<CategoriaEquipo>)ViewBag.Categorias; var beneficiarios=(List<Beneficiario>)ViewBag.Beneficiarios; }
<h1 class="h3">Módulo 02: Solicitudes e historial de préstamos</h1>
@if(User.IsInRole(RolNombre.Beneficiario)){<a class="btn btn-primary mb-3" asp-action="Editar">Nueva solicitud</a>}
<form method="get" class="row g-2 mb-3">
<div class="col-md-3"><label>Estado</label><select name="estado" class="form-select"><option value="">Todos</option>@foreach(var estado in Enum.GetNames<EstadoSolicitudPrestamo>().Concat(Enum.GetNames<EstadoPrestamo>()).Distinct()){<option value="@estado" selected="@(Context.Request.Query["estado"]==estado)">@estado</option>}</select></div>
@if(beneficiarios.Count>0){<div class="col-md-3"><label>Beneficiario</label><select name="beneficiario" class="form-select"><option value="">Todos</option>@foreach(var b in beneficiarios){<option value="@b.Id" selected="@(Context.Request.Query["beneficiario"]==b.Id.ToString())">@b.Usuario.NombreCompleto</option>}</select></div>}
<div class="col-md-2"><label>Categoría</label><select name="categoria" class="form-select"><option value="">Todas</option>@foreach(var c in categorias){<option value="@c.Id" selected="@(Context.Request.Query["categoria"]==c.Id.ToString())">@c.Nombre</option>}</select></div>
<div class="col-md-2"><label>Desde</label><input type="date" name="desde" value="@Context.Request.Query["desde"]" class="form-control"/></div><div class="col-md-2"><label>Hasta</label><input type="date" name="hasta" value="@Context.Request.Query["hasta"]" class="form-control"/></div><div><button class="btn btn-secondary">Filtrar</button> <a asp-action="Index">Limpiar</a></div></form>
@if(Model.Count==0){<p class="alert alert-info">No existen registros para los filtros seleccionados.</p>}
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Radicado</th><th>Beneficiario</th><th>Periodo</th><th>Solicitud</th><th>Préstamo</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Radicado</td><td>@s.Beneficiario.Usuario.NombreCompleto</td><td>@s.FechaInicioPrevista.ToString("yyyy-MM-dd") / @s.FechaFinPrevista.ToString("yyyy-MM-dd")</td><td>@s.Estado</td><td>@(s.Prestamo?.EstadoActual.ToString() ?? "Sin préstamo")</td><td><a asp-action="Detalle" asp-route-id="@s.Id">Ver detalle</a></td></tr>}</tbody></table></div>
