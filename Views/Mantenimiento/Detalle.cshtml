@model Mantenimiento
@{bool admin=User.IsInRole(RolNombre.Administrador); bool responsable=admin||User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value==Model.TecnicoId?.ToString();}
<h1>Reporte @Model.Id</h1><p>Equipo: @Model.Equipo.Serial | Estado: @Model.Estado</p><p>@Model.Falla</p><p>Detalle de devolución: @Model.DetalleDevolucionId</p>
@if(admin && Model.Abierto){<form asp-action="Asignar" method="post" class="card card-body mb-3"><input type="hidden" name="id" value="@Model.Id"/><label>Técnico responsable</label><select name="tecnicoId" class="form-select" required>@foreach(var t in (List<PerfilTecnico>)ViewBag.Tecnicos){<option value="@t.UsuarioId">@t.Usuario.NombreCompleto — @t.Especialidad</option>}</select><button class="btn btn-primary mt-2">Asignar o reasignar</button></form>}
@if(responsable && Model.Abierto && Model.Estado != EstadoMantenimiento.Pendiente){<form asp-action="Actualizar" method="post" class="card card-body mb-3"><input type="hidden" name="id" value="@Model.Id"/><label>Nuevo estado</label><select name="estado" class="form-select">@if(Model.Estado==EstadoMantenimiento.Asignado){<option value="EnRevision">En revisión</option>}else if(Model.Estado==EstadoMantenimiento.EnRevision){<option value="Reparado">Reparado</option><option value="Irreparable">Irreparable</option>}</select><label>Observación técnica</label><textarea name="observacion" required maxlength="1000" class="form-control"></textarea><button class="btn btn-primary mt-2">Actualizar</button></form>}
@if(responsable && Model.Estado==EstadoMantenimiento.EnRevision){<form asp-action="Repuesto" method="post" class="card card-body mb-3"><input type="hidden" name="id" value="@Model.Id"/><label>Actividad realizada</label><textarea name="actividad" required maxlength="1000" class="form-control"></textarea><label>Repuesto (opcional)</label><input name="nombre" maxlength="150" class="form-control"/><label>Cantidad</label><input name="cantidad" type="number" min="1" value="1" class="form-control"/><label>Costo unitario COP</label><input name="costoUnitario" type="number" min="0" step="0.01" value="0" class="form-control"/><button class="btn btn-primary mt-2">Registrar intervención</button></form>}
<h2>Historial</h2><table class="table"><tr><th>Fecha</th><th>Responsable ID</th><th>Detalle</th></tr>@foreach(var h in Model.Historial.OrderBy(h=>h.Fecha)){<tr><td>@h.Fecha</td><td>@h.ResponsableId</td><td>@h.Detalle</td></tr>}</table>
<h2>Repuestos</h2><table class="table"><tr><th>Nombre</th><th>Cantidad</th><th>Costo unitario</th></tr>@foreach(var r in Model.Repuestos){<tr><td>@r.Nombre</td><td>@r.Cantidad</td><td>@r.CostoUnitario</td></tr>}</table><p>Total COP: @Model.Repuestos.Sum(r=>r.Cantidad*r.CostoUnitario)</p><a asp-action="Index">Volver</a>
