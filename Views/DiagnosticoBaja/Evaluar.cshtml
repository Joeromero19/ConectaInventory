@model EvaluarBajaVM
@{
    ViewData["Title"] = "Evaluar baja";
    var s = Model.Solicitud!;
}

<h1 class="h3 mb-3">Evaluar solicitud de baja</h1>

<div class="card mb-3 col-lg-8">
    <ul class="list-group list-group-flush">
        <li class="list-group-item"><strong>Equipo:</strong> @s.Equipo.Identificador - @s.Equipo.Marca @s.Equipo.Modelo (serial @s.Equipo.Serial)</li>
        <li class="list-group-item"><strong>Estado actual:</strong> @s.Equipo.Estado.Texto()</li>
        <li class="list-group-item"><strong>Diagnostico:</strong> @s.Diagnostico.Resultado.Texto() - @s.Diagnostico.Hallazgos</li>
        <li class="list-group-item"><strong>Justificacion:</strong> @s.Motivo</li>
        <li class="list-group-item"><strong>Solicitada por:</strong> @s.Solicitante.NombreCompleto el @s.FechaSolicitud.ToString("yyyy-MM-dd HH:mm")</li>
    </ul>
</div>

<form asp-action="Evaluar" method="post" class="col-lg-8">
    <input type="hidden" asp-for="SolicitudId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="mb-3">
        <label class="form-label">Decision</label>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="Aprobar" id="aprobar" value="true" />
            <label class="form-check-label" for="aprobar">Aprobar baja (se emite el acta)</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="Aprobar" id="rechazar" value="false" checked />
            <label class="form-check-label" for="rechazar">Rechazar (requiere motivo)</label>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Motivo" class="form-label"></label>
        <textarea asp-for="Motivo" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Motivo" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Registrar decision</button>
    <a class="btn btn-outline-secondary" asp-action="Solicitudes">Volver</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
