@model StockVM
@{
    ViewData["Title"] = "Consulta de stock";
}

<h1 class="h3 mb-3">Consulta de stock</h1>

<form asp-action="Stock" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select"><option value="">Todas</option></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Estado" class="form-label"></label>
        <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoEquipo>()" class="form-select"><option value="">Todos</option></select>
    </div>
    <div class="col-md-3">
        <label asp-for="UbicacionId" class="form-label"></label>
        <select asp-for="UbicacionId" asp-items="Model.Ubicaciones" class="form-select"><option value="">Todas</option></select>
    </div>
    <div class="col-md-3">
        <div class="form-check mb-2">
            <input asp-for="SoloDisponibles" class="form-check-input" />
            <label asp-for="SoloDisponibles" class="form-check-label"></label>
        </div>
        <button type="submit" class="btn btn-primary">Aplicar filtros</button>
        <a class="btn btn-outline-secondary" asp-action="Stock">Limpiar</a>
    </div>
</form>

@if (!Model.Resultados.Any())
{
    <div class="alert alert-info">Sin coincidencias para los filtros seleccionados.</div>
}
else
{
    <p class="text-muted">
        @Model.Resultados.Count equipo(s) en stock fisico, @Model.Resultados.Count(r => r.Disponible) disponible(s) para prestamo.
    </p>
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr><th>Codigo</th><th>Serial</th><th>Equipo</th><th>Categoria</th><th>Ubicacion</th><th>Estado</th><th>Disponible</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Resultados)
                {
                    <tr>
                        <td>@item.Identificador</td>
                        <td>@item.Serial</td>
                        <td>@item.Marca @item.Modelo</td>
                        <td>@item.Categoria</td>
                        <td>@item.Ubicacion</td>
                        <td>@item.Estado.Texto()</td>
                        <td>@if (item.Disponible) { <span class="badge bg-success">Si</span> } else { <span class="badge bg-secondary">No</span> }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
