@model AltaVM
@{
    ViewData["Title"] = "Alta de equipo";
}

<h1 class="h3 mb-3">Alta de equipo</h1>

@if (!Model.Recepciones.Any())
{
    <div class="alert alert-warning">No hay recepciones con equipos pendientes de alta. El bodeguero debe registrar una recepcion primero.</div>
}
else
{
    <form asp-action="Alta" method="post" class="col-lg-7">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3">
            <label asp-for="RecepcionId" class="form-label"></label>
            <select asp-for="RecepcionId" asp-items="Model.Recepciones" class="form-select">
                <option value="0">Seleccione...</option>
            </select>
            <span asp-validation-for="RecepcionId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Serial" class="form-label"></label>
            <input asp-for="Serial" class="form-control" />
            <span asp-validation-for="Serial" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Marca" class="form-label"></label>
                <input asp-for="Marca" class="form-control" />
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Modelo" class="form-label"></label>
                <input asp-for="Modelo" class="form-control" />
                <span asp-validation-for="Modelo" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Especificaciones" class="form-label"></label>
            <textarea asp-for="Especificaciones" class="form-control" rows="2"></textarea>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CategoriaId" class="form-label"></label>
                <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select">
                    <option value="0">Seleccione...</option>
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="UbicacionId" class="form-label"></label>
                <select asp-for="UbicacionId" asp-items="Model.Ubicaciones" class="form-select">
                    <option value="0">Seleccione...</option>
                </select>
                <span asp-validation-for="UbicacionId" class="text-danger"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Guardar ficha</button>
    </form>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
