@model RecepcionVM
@{
    ViewData["Title"] = "Recepcion de donaciones";
}

<h1 class="h3 mb-3">Recepcion de donaciones</h1>
<p class="text-muted">Registra el lote recibido. Los equipos aun no estan disponibles para prestamo: el administrador los da de alta uno a uno.</p>

<form asp-action="Recepcion" method="post" class="col-lg-7">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row">
        <div class="col-md-7 mb-3">
            <label asp-for="DonanteNombre" class="form-label"></label>
            <input asp-for="DonanteNombre" class="form-control" />
            <span asp-validation-for="DonanteNombre" class="text-danger"></span>
        </div>
        <div class="col-md-5 mb-3">
            <label asp-for="DonanteContacto" class="form-label"></label>
            <input asp-for="DonanteContacto" class="form-control" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-7 mb-3">
            <label asp-for="Lote" class="form-label"></label>
            <input asp-for="Lote" class="form-control" />
            <span asp-validation-for="Lote" class="text-danger"></span>
        </div>
        <div class="col-md-5 mb-3">
            <label asp-for="CantidadFisica" class="form-label"></label>
            <input asp-for="CantidadFisica" type="number" min="1" class="form-control" />
            <span asp-validation-for="CantidadFisica" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Guardar lote</button>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
